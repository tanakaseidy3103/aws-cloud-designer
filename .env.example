# =========================================================================
# Optional: "Share to cloud" (POST /api/upload)
# Copy this file to '.env.local'. Keep '.env.local' out of git (it is in .gitignore).
#
# The feature is disabled (HTTP 501) unless AWS_S3_BUCKET_NAME is set.
# Every share is one S3 PUT plus storage: small, but billable.
# The bucket can stay PRIVATE: the API returns a short-lived presigned URL.
# The app has no user authentication: do not expose it publicly with these set.
# =========================================================================

AWS_S3_BUCKET_NAME=your_private_bucket_name_here
AWS_REGION=ap-northeast-1

# Presigned URL lifetime in seconds (default 3600, max 604800).
# SHARE_URL_TTL_SECONDS=3600

# Credentials: leave these unset to use the default AWS credential chain
# (aws sso login, AWS_PROFILE, instance/role credentials). Prefer that.
# Static keys are used only when both are set; grant them s3:PutObject and
# s3:GetObject on arn:aws:s3:::<bucket>/diagrams/* and nothing else.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
